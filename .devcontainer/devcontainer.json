{
  // Reproducible dev environment for tf-iac-vnet-module (§10 ALZ DX).
  // Usage: VS Code → "Reopen in Container" or open in GitHub Codespaces.
  // Every contributor gets identical tool versions; no "works on my machine".
  "name": "tf-iac-vnet-module",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "1.9.8"
    },
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.13"
    }
  },
  "postCreateCommand": "pip install pre-commit pytest tftest && pre-commit install",
  "customizations": {
    "vscode": {
      "extensions": [
        "hashicorp.terraform",
        "github.vscode-github-actions",
        "ms-azuretools.vscode-azureresourcegroups",
        "redhat.vscode-yaml",
        "EditorConfig.EditorConfig"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "[terraform]": {
          "editor.defaultFormatter": "hashicorp.terraform",
          "editor.formatOnSave": true
        }
      }
    }
  }
}
